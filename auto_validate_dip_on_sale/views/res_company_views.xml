<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_auto_validate" model="ir.ui.view">
        <field name="name">res.company.form.inherit.auto.validate.delivery</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <!-- Insert inside the notebook -->
            <xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
                <page string="Sales Automation">
                    <group string="Sales Automation">
                        <field name="auto_validate_delivery"/>
                        <field name="auto_invoice_on_delivery"/>
                        <field name="auto_register_payment"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>